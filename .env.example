# 丹智慧眼 - 环境变量示例（复制为 .env 并修改）
# docker compose 会自动读取同目录 .env 文件

# === 必改：安全关键 ===
# JWT 签名密钥，建议用 openssl rand -hex 32 生成
SECRET_KEY=change-me-to-a-long-random-string
# 管理员初始密码（仅首次初始化建号时使用）
ADMIN_PASSWORD=change-me-strong-password

# === 可选：数据库 ===
# 默认 sqlite，启用 PostgreSQL 时取消注释并配合 --profile prod
# DATABASE_URL=postgresql://dzhy:your-db-password@db:5432/dzhy
# POSTGRES_USER=dzhy
# POSTGRES_PASSWORD=your-db-password
# POSTGRES_DB=dzhy

# === 可选：服务配置 ===
# MODEL_API_URL=http://model:8000
# BACKEND_PORT=5000
# MODEL_PORT=8000
# CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# LOG_LEVEL=INFO
